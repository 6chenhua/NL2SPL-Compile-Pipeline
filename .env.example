# NL2SPL Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Configuration
# =============================================================================

# OpenAI API Key (required)
OPENAI_API_KEY=sk-your-api-key-here

# OpenAI API Base URL (optional, for custom endpoints)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Default model (optional, defaults to gpt-4o)
# OPENAI_MODEL=gpt-4o

# =============================================================================
# Pipeline Configuration
# =============================================================================

# Output directory for intermediate results (optional)
# OUTPUT_DIR=output

# Log level: DEBUG, INFO, WARNING, ERROR (optional, defaults to INFO)
# LOG_LEVEL=INFO

# Log file path (optional, logs to console only if not set)
# LOG_FILE=nl2spl.log

# Save intermediate results (optional, defaults to true)
# SAVE_INTERMEDIATE=true

# Maximum retries for LLM calls (optional, defaults to 3)
# MAX_RETRIES=3

# Retry delay in seconds (optional, defaults to 1.0)
# RETRY_DELAY=1.0

# =============================================================================
# Validation Configuration
# =============================================================================

# Enable SPL validation (optional, defaults to true)
# VALIDATE_SPL=true

# Strict mode for validation (optional, defaults to false)
# STRICT_MODE=false
